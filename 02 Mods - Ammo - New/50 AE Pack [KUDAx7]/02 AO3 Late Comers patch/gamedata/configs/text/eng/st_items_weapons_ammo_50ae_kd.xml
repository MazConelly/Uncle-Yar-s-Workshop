	<string id="ammo_50_ae_copper_solid">
		<text>.50 AE Copper Solid</text>
	</string>
	<string id="ammo_50_ae_copper_solid_descr">
		<text>A .50 Action Express solid copper cartridge (12.7x33mm) with a 300 grain jacketed hollow-point bullet, which provides an enormous stopping power. One of the most powerful unitary pistol cartridges in the world and has a significant lethality.\n \n
		%c[ui_gray_2]Country of origin: United States of America\n
		%c[d_purple]  %c[ui_gray_2] Tissue Damage: High\n
		%c[d_purple]  %c[ui_gray_2] Highest pierced armour class: BR6\n
		%c[d_purple]  %c[ui_gray_2] Type: Jacketed Hollow Point</text>
	</string>

