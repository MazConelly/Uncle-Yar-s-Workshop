        "wpn_sv98_custom_acog",
        "wpn_trg",
        "wpn_vssk",
        "wpn_w70",
    }
    function Set2 (k98_weapon_list)
        local set2 = {}
            for _,l 
                in ipairs(k98_weapon_list) 
                do set2[l] = true 
            end
        return set2
    end
    k98 = Set2 {
        "wpn_k98",
        "wpn_k98_mod",
        "wpn_k98_mod_silen98",
        "wpn_k98_mod_silen98",
        "wpn_kar98_retrotac",
        "wpn_kar98_retrotac_pn23fore",
        "wpn_karabiner98k",
        "wpn_karabiner98k_silen98",
    }
    
    base_fov = get_console():get_float("fov")
    descope_fov = base_fov-15
end

function actor_on_update()
    cwpn = db.actor:active_item():section()
end

function on_option_change()
    base_fov = get_console():get_float("fov")
    descope_fov = base_fov-15
end

function actor_on_weapon_zoom_in()
    cwpn = db.actor:active_item():section()
    if rifles[cwpn] then
        weapon_is_bolt = true
    else
        weapon_is_bolt = false
    end
    if k98[cwpn] then
        weapon_is_kar = true
    else
        weapon_is_kar = false
    end
end

function actor_on_weapon_fired()
    if weapon_is_bolt == true then
        block_zoom_in = false
        if device().fov<descope_fov then
            kar_has_scope = true
            demonized_time_events.CreateTimeEvent("unscope_delay",0,0.5,
            function()
                local is_aim_toggle = ui_options.get("control/general/aim_toggle")
                if is_aim_toggle then
                    level.press_action(bind_to_dik(key_bindings.kWPN_ZOOM))
                else	
                    level.release_action(bind_to_dik(key_bindings.kWPN_ZOOM))
                end
            return true
            end)
            if weapon_is_kar == true then 
                demonized_time_events.CreateTimeEvent("scope_block_delay",0,2.1,
                function()
                    block_zoom_in = false
                    kar_has_scope = false
                return true
                end)
            else return end
        else
            printf("FOV too big")
            kar_has_scope = false
        end
    else
        do printf("Was not on the list!") 
        end
    end
end

function actor_on_weapon_zoom_out()
    if weapon_is_kar == true and kar_has_scope == true then
        weapon_cycling = db.actor:active_item():get_state() or 0
        if weapon_cycling == 5 then
            block_zoom_in = true
        else
            printf("Not animating")
            block_zoom_in = false
        end
    else return
    end
end

function on_before_key_press(key,bind,dis,flags)
    if bind == key_bindings.kWPN_ZOOM
    and weapon_is_kar == true 
    and block_zoom_in == true then    
        flags.ret_value = false
    else
        flags.ret_value = true
    end        
end


function on_game_start()
    RegisterScriptCallback("actor_on_first_update",actor_on_first_update)
    RegisterScriptCallback("actor_on_weapon_zoom_in",actor_on_weapon_zoom_in)
    RegisterScriptCallback("actor_on_weapon_zoom_out",actor_on_weapon_zoom_out)
    RegisterScriptCallback("actor_on_weapon_fired",actor_on_weapon_fired)
    RegisterScriptCallback("on_before_key_press",on_before_key_press)
    RegisterScriptCallback("on_option_change",on_option_change)
end