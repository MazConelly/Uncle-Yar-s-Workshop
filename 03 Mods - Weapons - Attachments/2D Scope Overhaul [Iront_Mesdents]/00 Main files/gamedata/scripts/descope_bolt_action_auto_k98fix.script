local weapon_is_bolt = nil
local cwpn = nil
base_fov = nil
local descope_fov = nil
local k98 = nil
local rifles = nil
local weapon_is_kar = false
local block_zoom_in = false
local weapon_cycling = false


function actor_on_first_update()
